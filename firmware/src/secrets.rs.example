//! Credentials for the usage display. This file is GITIGNORED.
//! Copy `secrets.rs.example` to `secrets.rs` and fill in your values.

/// 2.4 GHz Wi-Fi credentials.
pub const WIFI_SSID: &str = "your-ssid";
pub const WIFI_PASSWORD: &str = "your-password";

/// Bearer token for `GET https://api.kimi.com/coding/v1/usages`.
///
/// Use a long-lived API Key from the Kimi Code Console. A short-lived OAuth
/// access token (from `~/.kimi-code/credentials/kimi-code.json`) works too
/// but expires after ~15 minutes.
pub const KIMI_TOKEN: &str = "your-token";
