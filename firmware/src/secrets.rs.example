// Credentials for the usage display. This file lives OUTSIDE the repo:
// copy it to ~/.config/esp32-epaper/secrets.rs (or point the EPAPER_SECRETS
// env var at it) — firmware/build.rs feeds it into the build, and no secret
// ever touches the source tree.

/// 2.4 GHz Wi-Fi credentials.
pub const WIFI_SSID: &str = "TODO-SSID";
pub const WIFI_PASSWORD: &str = "TODO-PASSWORD";

/// API key for `GET https://api.kimi.com/coding/v1/usages`
/// (long-lived `sk-kimi-...` key from the Kimi Code Console; the JS
/// coding-usage-bar keeps one in ~/.coding-usage-bar/config.json).
/// A CLI OAuth token works too but expires after ~15 minutes.
pub const KIMI_TOKEN: &str = "TODO-TOKEN";
