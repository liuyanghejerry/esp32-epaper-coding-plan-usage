# Copy to .env (gitignored) and fill in. Baked into the firmware at build time.

# 2.4 GHz Wi-Fi (ESP32-S3 does not support 5 GHz)
WIFI_SSID=your-ssid
WIFI_PASSWORD=your-password

# Long-lived API key from the Kimi Code Console (sk-kimi-...); also found in
# the JS coding-usage-bar config ~/.coding-usage-bar/config.json.
# A CLI OAuth token works too but expires after ~15 minutes.
KIMI_TOKEN=sk-kimi-...
